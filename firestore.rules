rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cada usuário autenticado acessa somente seu próprio perfil.
    match /usuarios/{userId} {
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.keys().hasOnly(["uid","nome","sobrenome","apelido","sexo","email","photoURL","criadoEm","veiculoSelecionado"])
        && (!("veiculoSelecionado" in request.resource.data) || request.resource.data.veiculoSelecionado in ["classica","moderna"]);
      allow read, delete: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.email == request.auth.token.email;
    }
    match /usuarios/{userId}/{tipo}/{registroId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == userId
        && (tipo == "receitas" || tipo == "despesas");
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}